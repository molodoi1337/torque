# База данных: локально по умолчанию file:local.db, в продакшене — Turso
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=

# Секрет для подписи сессий: openssl rand -base64 32
AUTH_SECRET=

# Необязательно: уведомления о новых записях в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
